<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console app that calls Logic.greet twice a second and never calls
       Logic.neverCalled. spec/e2e/e2e_reload_display_spec.lua runs it with
       run_app and saves each function, to see a pending patch become "patched"
       and an uncalled one become "never ran". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Logic.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
